#!/usr/bin/env bash

set -euo pipefail

export RUSTUP_TOOLCHAIN=1.99.0
export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"

if ! command -v rustup > /dev/null; then
  curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | \
    sh -s -- -y --profile minimal --default-toolchain none --no-modify-path
fi

rustup toolchain install "$RUSTUP_TOOLCHAIN" --profile minimal \
  --target wasm32-unknown-unknown

cargo install --locked --version 1.58.0 just
cargo install --locked --version 0.15.0 wasm-pack

EMSDK_DIR=$(mktemp -d)
trap 'rm -rf "$EMSDK_DIR"' EXIT

git clone --depth 1 --branch 6.0.12 \
  https://github.com/emscripten-core/emsdk.git "$EMSDK_DIR"

"$EMSDK_DIR/emsdk" install 6.0.12
"$EMSDK_DIR/emsdk" activate 6.0.12

EMSDK_ENV=$(EMSDK_BASH=1 "$EMSDK_DIR/emsdk" construct_env)
eval "$EMSDK_ENV"

just build-web
